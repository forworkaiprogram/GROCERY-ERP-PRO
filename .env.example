# Cloud backend configuration (copy to backend/.env; never commit real values)
DJANGO_SECRET_KEY=change-me-64-random-bytes
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=api.example.com
DATABASE_URL=postgres://grocerierp:opaque@db:5432/grocerierp
REDIS_URL=redis://redis:6379/0
ENTITLEMENT_SIGNING_KEY_PATH=/run/secrets/entitlement_signing_key.pem
UPDATE_SIGNING_KEY_PATH=/run/secrets/update_signing_key.pem
UPDATE_STORAGE_PATH=/var/lib/grocerierp/update-packages
BACKUP_PATH=/var/backups/grocerierp

# --- docker compose (infrastructure/) ---
POSTGRES_DB=grocery
POSTGRES_USER=grocery
POSTGRES_PASSWORD=change-me-strong
